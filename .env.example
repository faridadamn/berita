# Wajib: rahasia buat tanda tangan session (min 32 karakter acak)
AUTH_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Opsional sekarang (tahap 1 jalan pakai data dummy). Isi kalau sudah pakai Postgres.
DATABASE_URL=postgres://user:pass@localhost:5432/berita

# Akun admin awal (dipakai saat DATABASE_URL kosong, dan oleh scripts/seed.ts)
ADMIN_EMAIL=admin@studio.local
# Hash bcrypt dari password. Buat dengan: npm run hash -- passwordkamu
# Tanda $ WAJIB di-escape jadi \$ (Next.js meng-expand variabel di .env).
# Kalau dikosongkan, mode dev pakai password default "studio123". Production wajib diisi.
ADMIN_PASSWORD_HASH=

# Branding
NEXT_PUBLIC_BRAND_NAME=Berita
NEXT_PUBLIC_BRAND_HANDLE=@akunkamu
