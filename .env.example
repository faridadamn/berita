# ── Wajib ─────────────────────────────────────────────────────────────
# Rahasia session + kunci enkripsi API key provider AI (min 32 karakter acak).
# Buat: openssl rand -base64 32   — JANGAN diganti setelah ada provider tersimpan
AUTH_SECRET=

# Postgres. Pilih salah satu:
#  Neon  : postgres://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/berita?sslmode=require
#  Lokal : postgres://postgres:postgres@localhost:5432/berita
DATABASE_URL=

# Rahasia untuk endpoint penjadwal /api/cron
CRON_SECRET=

# URL publik aplikasi (https). Wajib untuk posting Instagram & Threads, karena
# mereka mengambil gambar dari {APP_URL}/m/... Juga dipakai untuk shortlink di Threads/X.
APP_URL=https://studio.domainkamu.com

# ── Akun admin pertama ────────────────────────────────────────────────
# Login pertama dengan email ini otomatis membuat akun admin (selama tabel users kosong).
ADMIN_EMAIL=admin@studio.local
# Hash bcrypt password admin: npm run hash -- passwordkamu
# Di file .env tanda $ WAJIB di-escape jadi \$ (output script sudah begitu).
# Mode dev: kalau kosong, password default "studio123". Production: wajib diisi.
ADMIN_PASSWORD_HASH=

# ── Branding ──────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=Berita
NEXT_PUBLIC_BRAND_HANDLE=@akunkamu

# ── AI (opsional) ─────────────────────────────────────────────────────
# Cara utama: tambah provider di Admin → Pengaturan (bisa banyak, urutan = fallback).
# Kalau belum ada provider di sana, key di bawah ini dipakai sebagai cadangan:
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   (DeepSeek/OpenRouter/Groq/Ollama juga bisa)
# OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_TIMEOUT_MS=90000

# ── Worker (kalau pakai `npm run worker`) ────────────────────────────
# APP_URL=http://localhost:3000
# WORKER_INTERVAL_MIN=15

# ── Publish (opsional) ───────────────────────────────────────────────
# PUBLISH_POLL_MS=3000         jeda cek status media IG/Threads
# PUBLISH_MAX_WAIT_MS=90000    batas tunggu media diproses
